// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// AUTHENTIFICATION //
//////////////////////

model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String
  name         String?

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Application Pokémon
  cards        Card[]
  sealed       SealedProduct[]
  sales        Sale[]
  watched      WatchedCard[]
  shoppingLots ShoppingLot[]

  createdAt DateTime @default(now())
}

model Account {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())

  sessionToken String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime

  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////
// COLLECTION POKEMON
//////////////////////

model Card {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identifiant TCGdex (ex. « sv10-230 ») retenu lors de la recherche
  // automatique, pour retrouver la carte dans la base de référence.
  externalId String?

  name String

  extension String?

  number String?

  category String?

  language String?

  condition String?

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?

  // Position choisie à la main par glisser-déposer. Une carte ajoutée
  // reçoit une valeur très négative pour apparaître en tête, comme avant.
  sortOrder Float @default(0)

  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())

  priceHistory PriceHistory[]
}

model SealedProduct {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identifiant produit TCGplayer, même usage que pour les cartes.
  externalId String?

  name String

  type String

  language String?

  condition String?

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?

  // Position choisie à la main par glisser-déposer. Les produits existants
  // valent 0 et restent départagés par `createdAt` ; un produit ajouté reçoit
  // une valeur très négative pour apparaître en tête, comme avant.
  sortOrder Float @default(0)

  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())

  priceHistory PriceHistory[]
}

//////////////////////
// CARTES SUIVIES
//////////////////////

/// Carte que l'on surveille sans la posséder.
///
/// Volontairement dépourvue de prix et de date d'achat : c'est ce qui la
/// distingue d'une carte de la collection, et ce qui la tient à l'écart des
/// statistiques d'investissement. L'achat la transforme en `Card`.
model WatchedCard {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalId String?

  name String

  extension String?

  number String?

  category String?

  language String?

  condition String?

  quantity Int @default(1)

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?

  // Position choisie à la main par glisser-déposer. Les cartes existantes
  // valent 0 et restent départagées par `createdAt` ; une carte ajoutée
  // reçoit une valeur très négative pour apparaître en tête, comme avant.
  sortOrder Float @default(0)

  // Lots d'achat simulé (« Shop Wizard ») auxquels cette carte appartient.
  // Une carte peut figurer dans plusieurs lots à la fois.
  lots ShoppingLot[]

  imageUrl String?

  cardmarketUrl String?

  notes String?

  createdAt DateTime @default(now())

  priceHistory PriceHistory[]
}

//////////////////////
// FUTURS ACHATS
//////////////////////

/// Lot nommé de cartes suivies, pour simuler le coût d'un achat groupé
/// (ex. « Alt 30 ans ») sans toucher au prix d'achat réel : le total se
/// recalcule à chaque affichage depuis `WatchedCard.currentPrice`.
model ShoppingLot {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  cards WatchedCard[]

  createdAt DateTime @default(now())
}

//////////////////////
// VENTES
//////////////////////

model Sale {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType String

  itemCategory String?

  itemName String

  // Caractéristiques recopiées depuis la collection au moment de la vente :
  // l'article vendu en sort, ses informations doivent survivre à sa
  // suppression pour rester consultables dans l'historique.
  itemNumber String?

  extension String?

  language String?

  condition String?

  cardmarketUrl String?

  quantity Int @default(1)

  purchasePrice Float

  salePrice Float

  gain Float

  percentage Float?

  imageUrl String?

  saleDate DateTime

  createdAt DateTime @default(now())
}

//////////////////////
// HISTORIQUE DES PRIX
//////////////////////

/// Courbe d'évolution du prix d'une carte, d'un produit scellé ou d'une carte
/// suivie. Un seul point par jour et par article : une nouvelle saisie sur
/// une date déjà enregistrée met à jour ce point au lieu d'en empiler un
/// autre (évite l'explosion du nombre de lignes si le prix est corrigé
/// plusieurs fois le même jour).
model PriceHistory {
  id String @id @default(uuid())

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  sealedId String?
  sealed   SealedProduct? @relation(fields: [sealedId], references: [id], onDelete: Cascade)

  watchedId String?
  watched   WatchedCard? @relation(fields: [watchedId], references: [id], onDelete: Cascade)

  price Float

  date DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([cardId, date])
  @@unique([sealedId, date])
  @@unique([watchedId, date])
}

