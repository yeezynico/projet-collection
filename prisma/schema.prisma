// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// AUTHENTIFICATION //
//////////////////////

model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String
  name         String?

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Application Pokémon
  cards  Card[]
  sealed SealedProduct[]
  sales  Sale[]

  createdAt DateTime @default(now())
}

model Account {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())

  sessionToken String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime

  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////
// COLLECTION POKEMON
//////////////////////

model Card {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  extension String?

  category String?

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())
}

model SealedProduct {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  type String

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())
}

//////////////////////
// VENTES
//////////////////////

model Sale {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType String

  itemName String

  quantity Int @default(1)

  purchasePrice Float

  salePrice Float

  gain Float

  percentage Float?

  imageUrl String?

  saleDate DateTime

  createdAt DateTime @default(now())
}
