// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// AUTHENTIFICATION //
//////////////////////

model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String
  name         String?

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Application Pokémon
  cards   Card[]
  sealed  SealedProduct[]
  sales   Sale[]
  watched WatchedCard[]

  createdAt DateTime @default(now())
}

model Account {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())

  sessionToken String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime

  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////
// COLLECTION POKEMON
//////////////////////

model Card {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identifiant TCGdex (ex. « sv10-230 ») retenu lors de la recherche
  // automatique, pour retrouver la carte dans la base de référence.
  externalId String?

  name String

  extension String?

  number String?

  category String?

  language String?

  condition String?

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?


  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())
}

model SealedProduct {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identifiant produit TCGplayer, même usage que pour les cartes.
  externalId String?

  name String

  type String

  language String?

  condition String?

  quantity Int @default(1)

  purchasePrice Float

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?


  imageUrl String?

  cardmarketUrl String?

  purchaseDate DateTime

  createdAt DateTime @default(now())
}

//////////////////////
// CARTES SUIVIES
//////////////////////

/// Carte que l'on surveille sans la posséder.
///
/// Volontairement dépourvue de prix et de date d'achat : c'est ce qui la
/// distingue d'une carte de la collection, et ce qui la tient à l'écart des
/// statistiques d'investissement. L'achat la transforme en `Card`.
model WatchedCard {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalId String?

  name String

  extension String?

  number String?

  category String?

  language String?

  condition String?

  quantity Int @default(1)

  currentPrice Float?

  priceSource String?

  priceUpdatedAt DateTime?

  imageUrl String?

  cardmarketUrl String?

  notes String?

  createdAt DateTime @default(now())
}

//////////////////////
// VENTES
//////////////////////

model Sale {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType String

  itemCategory String?

  itemName String

  // Caractéristiques recopiées depuis la collection au moment de la vente :
  // l'article vendu en sort, ses informations doivent survivre à sa
  // suppression pour rester consultables dans l'historique.
  itemNumber String?

  extension String?

  language String?

  condition String?

  cardmarketUrl String?

  quantity Int @default(1)

  purchasePrice Float

  salePrice Float

  gain Float

  percentage Float?

  imageUrl String?

  saleDate DateTime

  createdAt DateTime @default(now())
}

